#!/bin/bash

set -euo pipefail

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readonly project_root

"$project_root/tests/manifest.test.sh"
"$project_root/tests/scan.test.sh"
"$project_root/tests/folders.test.sh"
"$project_root/tests/trash.test.sh"
"$project_root/tests/scanner-efficiency.test.sh"
node "$project_root/tests/model.test.js"
"$project_root/tests/english.test.sh"

if command -v shellcheck >/dev/null; then
  shellcheck \
    "$project_root/bin/dev-sync" \
    "$project_root/bin/test" \
    "$project_root/scripts/build-showcase" \
    "$project_root/scripts/disk-lens-folders" \
    "$project_root/scripts/disk-lens-scan" \
    "$project_root/scripts/disk-lens-trash" \
    "$project_root/tests/english.test.sh" \
    "$project_root/tests/manifest.test.sh" \
    "$project_root/tests/scan.test.sh" \
    "$project_root/tests/folders.test.sh" \
    "$project_root/tests/trash.test.sh" \
    "$project_root/tests/scanner-efficiency.test.sh" \
    "$project_root/tests/lab/acceptance.sh" \
    "$project_root/tests/lab/public-install.sh" \
    "$project_root/tests/fixtures/slow-bin/find" \
    "$project_root/tests/fixtures/slow-bin/du" \
    "$project_root/tests/fixtures/locale-bin/stat" \
    "$project_root/tests/fixtures/trash-bin/gio" \
    "$project_root/tests/fixtures/counting-bin/base64" \
    "$project_root/tests/fixtures/counting-bin/iconv" \
    "$project_root/tests/fixtures/counting-bin/jq" \
    "$project_root/tests/fixtures/counting-bin/stat"
  printf 'ok - ShellCheck\n'
fi

if [[ -n ${OMARCHY_SOURCE:-} && -d $OMARCHY_SOURCE/shell ]] && command -v qmllint >/dev/null; then
  qmllint -I "$OMARCHY_SOURCE/shell" \
    "$project_root/src/Service.qml" \
    "$project_root/src/BarWidget.qml" \
    "$project_root/src/ActivityRing.qml" \
    "$project_root/src/PieGauge.qml"
  printf 'ok - QML lint against selected Omarchy source\n'
fi
