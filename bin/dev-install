#!/bin/bash

# Install an exact snapshot of the current development working tree into the
# active Omarchy user session. This is intentionally opt-in: invoking it
# replaces the installed development copy of Disk Lens.

set -euo pipefail

readonly plugin_id="io.github.mtolhuys.disk-lens"
project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
readonly project_root
readonly cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-disk-lens"
readonly snapshot_dir="$cache_root/development-source"
readonly installed_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$plugin_id"
readonly shell_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"

fail() {
  printf 'dev-install: %s\n' "$*" >&2
  exit 1
}

(( EUID != 0 )) || fail "run this as the Omarchy desktop user, not root"

for command_name in git jq omarchy omarchy-shell sed tar; do
  command -v "$command_name" >/dev/null 2>&1 || fail "required command is missing: $command_name"
done

identity_from() {
  sed -n 's/^[[:space:]]*readonly property string buildIdentity: "\([^"]*\)".*/\1/p' "$1"
}

plugin_known() {
  omarchy plugin list --json | jq -e --arg id "$plugin_id" \
    'any(.[]; .id == $id)' >/dev/null
}

wait_for_plugin_state() {
  local expected="$1"
  local attempt

  for attempt in {1..200}; do
    if [[ $expected == known ]] && plugin_known; then
      return 0
    fi
    if [[ $expected == absent ]] && ! plugin_known; then
      return 0
    fi
    if (( attempt % 20 == 0 )); then
      omarchy-shell shell rescanPlugins >/dev/null || true
    fi
    sleep 0.1
  done

  return 1
}

expected_service_identity=$(identity_from "$project_root/src/Service.qml")
expected_widget_identity=$(identity_from "$project_root/src/BarWidget.qml")
readonly expected_service_identity expected_widget_identity

[[ -n $expected_service_identity ]] || fail "could not read the service build identity"
[[ -n $expected_widget_identity ]] || fail "could not read the widget build identity"

printf 'Checking the current Disk Lens working tree...\n'
"$project_root/bin/test"
omarchy plugin validate "$project_root"

mkdir -p -- "$cache_root"
if [[ -e $snapshot_dir && ! -d $snapshot_dir/.git ]]; then
  fail "$snapshot_dir exists but is not a development snapshot"
fi

if [[ ! -d $snapshot_dir/.git ]]; then
  mkdir -p -- "$snapshot_dir"
  git -C "$snapshot_dir" init -q
fi

# Remove every path owned by the previous snapshot before extracting the new
# working tree. NUL-delimited Git output keeps unusual development filenames
# structural rather than interpreting them as shell input.
while IFS= read -r -d '' tracked_path; do
  rm -f -- "$snapshot_dir/$tracked_path"
done < <(git -C "$snapshot_dir" ls-files -z)

tar -C "$project_root" \
  --exclude='./.git' \
  --exclude='./test-results' \
  --exclude='./dist' \
  -cf - . | tar -C "$snapshot_dir" -xf -

git -C "$snapshot_dir" add -A
if ! git -C "$snapshot_dir" rev-parse --verify HEAD >/dev/null 2>&1 \
    || ! git -C "$snapshot_dir" diff --cached --quiet; then
  git -C "$snapshot_dir" \
    -c user.name="Disk Lens Development" \
    -c user.email="disk-lens-development@invalid" \
    commit -qm "Development snapshot"
fi

snapshot_commit=$(git -C "$snapshot_dir" rev-parse HEAD)
snapshot_short_commit=$(git -C "$snapshot_dir" rev-parse --short=12 HEAD)

previous_placement=""
if [[ -f $shell_config ]]; then
  previous_placement=$(jq -r --arg id "$plugin_id" '
    first(
      ["left", "center", "right"][] as $section
      | (.bar.layout[$section] // [])
      | to_entries[]
      | select((if (.value | type) == "object" then .value.id else .value end) == $id)
      | [$section, (.key | tostring)]
      | @tsv
    ) // empty
  ' "$shell_config")
fi

if [[ -e $installed_dir || -L $installed_dir ]]; then
  printf 'Replacing the installed Disk Lens development copy...\n'
  omarchy plugin remove "$plugin_id" --yes
fi

omarchy-shell shell rescanPlugins >/dev/null
wait_for_plugin_state absent \
  || fail "the removed plugin remained in the Omarchy catalog after rescanning"

# Omarchy's combined add-and-enable path has a short internal discovery window.
# Keep the phases separate so a busy shell cannot race enablement against its
# asynchronous manifest scan, and so a checkout left by an interrupted add can
# be recovered by simply running this command again.
omarchy plugin add "$snapshot_dir" --yes
omarchy-shell shell rescanPlugins >/dev/null
wait_for_plugin_state known \
  || fail "the installed plugin was not discovered after repeated rescans"

enable_args=()
if [[ -n $previous_placement ]]; then
  IFS=$'\t' read -r previous_section previous_index <<<"$previous_placement"
  enable_args=(--section "$previous_section" --index "$previous_index")
fi
omarchy plugin enable "$plugin_id" "${enable_args[@]}"

enabled=false
for _ in {1..100}; do
  if omarchy plugin list --json | jq -e --arg id "$plugin_id" \
      'any(.[]; .id == $id and .enabled == true)' >/dev/null; then
    enabled=true
    break
  fi
  sleep 0.1
done
[[ $enabled == true ]] || fail "the plugin was discovered but did not become enabled"

[[ -d $installed_dir/.git ]] || fail "Omarchy did not create the installed plugin checkout"
installed_commit=$(git -C "$installed_dir" rev-parse HEAD)
installed_origin=$(git -C "$installed_dir" remote get-url origin)

[[ $installed_origin == "$snapshot_dir" ]] \
  || fail "the installed plugin does not point to the current development snapshot"
[[ $installed_commit == "$snapshot_commit" ]] \
  || fail "the installed plugin commit does not match the current development snapshot"
[[ -z $(git -C "$installed_dir" status --porcelain) ]] \
  || fail "the installed plugin checkout differs from the current development snapshot"

loaded=false
for _ in {1..100}; do
  if omarchy-shell disk-lens-service state 2>/dev/null | jq -e \
      --arg expected "$expected_service_identity" '.buildIdentity == $expected' >/dev/null \
      && omarchy-shell disk-lens state 2>/dev/null | jq -e \
      --arg expected "$expected_widget_identity" '.buildIdentity == $expected' >/dev/null; then
    loaded=true
    break
  fi
  sleep 0.1
done

[[ $loaded == true ]] || fail "the plugin was installed but its runtime identity did not become ready"

printf 'Disk Lens development snapshot %s is installed, enabled, and loaded.\n' "$snapshot_short_commit"
