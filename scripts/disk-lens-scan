#!/bin/bash

set -uo pipefail

readonly protocol=1
readonly max_entries=5000
readonly max_emitted_warnings=20
readonly metadata_batch_size=256
scan_path=""
work_dir=""
measure_pid=""
declare -a measure_pids=()
declare -a entry_paths=()
declare -a entry_sizes=()
declare -a json_batch=()

emit_error() {
  local code=$1
  local message=$2
  jq -cn \
    --argjson protocol "$protocol" \
    --arg code "$code" \
    --arg message "$message" \
    '{protocol: $protocol, type: "error", code: $code, message: $message}'
}

# shellcheck disable=SC2329 # Invoked by EXIT and signal traps.
cleanup() {
  if [[ -n $work_dir && -d $work_dir ]]; then
    rm -rf -- "$work_dir"
  fi
}

# shellcheck disable=SC2329 # Invoked by stop_scan on INT/TERM.
terminate_measurement() {
  local pid
  for pid in "${measure_pids[@]+"${measure_pids[@]}"}"; do
    if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
  if [[ -n $measure_pid ]] && kill -0 "$measure_pid" 2>/dev/null; then
    # Kill the whole measurement process group when available.
    kill -TERM -- "-$measure_pid" 2>/dev/null || kill -TERM "$measure_pid" 2>/dev/null || true
  fi
  for pid in "${measure_pids[@]+"${measure_pids[@]}"}"; do
    if [[ -n $pid ]]; then
      wait "$pid" 2>/dev/null || true
    fi
  done
  if [[ -n $measure_pid ]]; then
    wait "$measure_pid" 2>/dev/null || true
  fi
  measure_pids=()
  measure_pid=""
}

# shellcheck disable=SC2329 # Invoked by INT and TERM traps.
stop_scan() {
  trap - INT TERM
  terminate_measurement
  cleanup
  exit 130
}

usage() {
  printf 'Usage: disk-lens-scan --path ABSOLUTE_DIRECTORY\n' >&2
}

flush_json_batch() {
  (( ${#json_batch[@]} > 0 )) || return 0

  jq -cn \
    --argjson protocol "$protocol" \
    --args \
    '$ARGS.positional as $values
      | range(0; $values | length; 5) as $index
      | ($values[$index]) as $path
      | {
          protocol: $protocol,
          type: "entry",
          path: $path,
          pathB64: ($path | @base64),
          name: $values[$index + 1],
          kind: $values[$index + 2],
          allocatedBytes: ($values[$index + 3] | tonumber),
          mtime: ($values[$index + 4] | tonumber),
          validUtf8: true,
          actionable: true
        }' \
    -- "${json_batch[@]}"
  json_batch=()
}

emit_invalid_utf8_entry() {
  local entry_path=$1
  local allocated_bytes=$2
  local entry_kind=$3
  local entry_mtime=$4
  local entry_b64

  entry_b64=$(printf '%s' "$entry_path" | base64 -w0)
  jq -cn \
    --argjson protocol "$protocol" \
    --arg path "$entry_path" \
    --arg pathB64 "$entry_b64" \
    --arg kind "$entry_kind" \
    --argjson allocatedBytes "$allocated_bytes" \
    --argjson mtime "$entry_mtime" \
    '{
      protocol: $protocol,
      type: "entry",
      path: $path,
      pathB64: $pathB64,
      name: "[name is not valid UTF-8]",
      kind: $kind,
      allocatedBytes: $allocatedBytes,
      mtime: $mtime,
      validUtf8: false,
      actionable: false
    }'
}

scan_jobs() {
  local jobs=${DISK_LENS_SCAN_JOBS:-}
  if [[ ! $jobs =~ ^[1-9][0-9]*$ ]]; then
    jobs=$(nproc 2>/dev/null || printf '4')
  fi
  if (( jobs < 1 )); then
    jobs=1
  elif (( jobs > 32 )); then
    jobs=32
  fi
  printf '%s' "$jobs"
}

# Measure immediate children: real directories via parallel du -s; other entries
# via batched st_blocks accounting. Independent child measurement matches
# `du -s -- child` per entry and parallelizes the recursive work safely.
measure_children() {
  local max_jobs child out_file active pid status=0
  local -a dirs=()
  local -a nondirs=()

  shopt -s nullglob dotglob

  for child in "$scan_path"/*; do
    if [[ -d $child && ! -L $child ]]; then
      dirs+=("$child")
    else
      nondirs+=("$child")
    fi
  done

  shopt -u nullglob dotglob

  : >"$work_dir/records"
  : >"$work_dir/errors"

  mkdir -p -- "$work_dir/du-out"
  max_jobs=$(scan_jobs)
  active=0
  for child in "${dirs[@]+"${dirs[@]}"}"; do
    while (( active >= max_jobs )); do
      if ! wait -n; then
        status=1
      fi
      (( active -= 1 )) || true
    done
    out_file=$(mktemp "$work_dir/du-out/XXXXXX")
    # PATH-resolved du keeps cancellation fixtures working.
    du -s --one-file-system --block-size=1 --null -- "$child" \
      >"$out_file" 2>>"$work_dir/errors" &
    pid=$!
    measure_pids+=("$pid")
    (( active += 1 ))
  done

  while (( active > 0 )); do
    if ! wait -n; then
      status=1
    fi
    (( active -= 1 )) || true
  done

  for out_file in "$work_dir"/du-out/*; do
    [[ -f $out_file ]] || continue
    cat -- "$out_file" >>"$work_dir/records"
  done

  if (( ${#nondirs[@]} > 0 )); then
    local batch_start batch_count batch_paths metadata_file
    local metadata_path metadata_blocks
    for (( batch_start = 0; batch_start < ${#nondirs[@]}; batch_start += metadata_batch_size )); do
      batch_count=$((${#nondirs[@]} - batch_start))
      if (( batch_count > metadata_batch_size )); then
        batch_count=$metadata_batch_size
      fi
      batch_paths=("${nondirs[@]:batch_start:batch_count}")
      metadata_file="$work_dir/nondir-$batch_start"
      LC_ALL=C stat --printf '%n\0%b\0' -- "${batch_paths[@]}" \
        >"$metadata_file" 2>>"$work_dir/errors" || true
      while IFS= read -r -d '' metadata_path \
          && IFS= read -r -d '' metadata_blocks; do
        if [[ $metadata_blocks =~ ^[0-9]+$ ]]; then
          printf '%s\t%s\0' "$((metadata_blocks * 512))" "$metadata_path" \
            >>"$work_dir/records"
        fi
      done <"$metadata_file"
    done
  fi

  return "$status"
}

if (( EUID == 0 )); then
  emit_error "root-refused" "Disk Lens scans must run as the desktop user."
  exit 77
fi

if (( $# != 2 )) || [[ $1 != "--path" ]]; then
  usage
  emit_error "invalid-arguments" "Expected exactly --path and one directory."
  exit 64
fi

if [[ $2 != /* ]]; then
  emit_error "relative-path" "The scan path must be absolute."
  exit 64
fi

if [[ ! -d $2 ]]; then
  emit_error "not-a-directory" "The selected scan path is not a directory."
  exit 66
fi

scan_path=$(realpath -e -- "$2") || {
  emit_error "unresolvable-path" "The selected scan path could not be resolved."
  exit 66
}

if ! printf '%s' "$scan_path" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
  emit_error "invalid-path-encoding" "The selected scan path is not valid UTF-8."
  exit 66
fi

work_dir=$(mktemp -d -t omarchy-disk-lens.XXXXXX) || {
  emit_error "temporary-storage" "Disk Lens could not create temporary scan storage."
  exit 73
}

trap cleanup EXIT
trap stop_scan INT TERM

jq -cn \
  --argjson protocol "$protocol" \
  --arg path "$scan_path" \
  '{protocol: $protocol, type: "start", path: $path}'

# Run measurement in the foreground of this script so cancellation can terminate
# every owned du child. Status reflects whether any du/stat failed.
measure_status=0
if ! measure_children; then
  measure_status=1
fi
measure_pids=()

entry_count=0
warning_count=0
emitted_warning_count=0
total_bytes=0
truncated=false
records_are_utf8=true

if ! iconv -f UTF-8 -t UTF-8 "$work_dir/records" >/dev/null 2>&1; then
  records_are_utf8=false
fi

while IFS= read -r -d '' record; do
  [[ $record == *$'\t'* ]] || continue
  allocated_bytes=${record%%$'\t'*}
  entry_path=${record#*$'\t'}

  [[ $allocated_bytes =~ ^[0-9]+$ ]] || continue
  if [[ $entry_path == "$scan_path" ]]; then
    continue
  fi

  (( total_bytes += allocated_bytes ))

  if (( entry_count >= max_entries )); then
    truncated=true
    continue
  fi

  entry_paths+=("$entry_path")
  entry_sizes+=("$allocated_bytes")
  (( entry_count += 1 ))
done <"$work_dir/records"

declare -A metadata_kind_by_path=()
declare -A metadata_mtime_by_path=()

for (( batch_start = 0; batch_start < entry_count; batch_start += metadata_batch_size )); do
  batch_count=$((entry_count - batch_start))
  if (( batch_count > metadata_batch_size )); then
    batch_count=$metadata_batch_size
  fi

  metadata_file="$work_dir/metadata-$batch_start"
  batch_paths=("${entry_paths[@]:batch_start:batch_count}")
  LC_ALL=C stat --printf '%n\0%F\0%Y\0' -- "${batch_paths[@]}" >"$metadata_file" 2>/dev/null || true

  while IFS= read -r -d '' metadata_path \
      && IFS= read -r -d '' metadata_type \
      && IFS= read -r -d '' metadata_mtime; do
    case $metadata_type in
      directory) metadata_kind_by_path["$metadata_path"]="directory" ;;
      "regular file") metadata_kind_by_path["$metadata_path"]="file" ;;
      "symbolic link") metadata_kind_by_path["$metadata_path"]="symlink" ;;
      *) metadata_kind_by_path["$metadata_path"]="other" ;;
    esac
    metadata_mtime_by_path["$metadata_path"]=$metadata_mtime
  done <"$metadata_file"

  for (( batch_index = 0; batch_index < batch_count; batch_index += 1 )); do
    entry_index=$((batch_start + batch_index))
    entry_path=${entry_paths[$entry_index]}
    allocated_bytes=${entry_sizes[$entry_index]}
    entry_kind=${metadata_kind_by_path["$entry_path"]:-other}
    entry_mtime=${metadata_mtime_by_path["$entry_path"]:-0}

    # GNU stat can report negative seconds for valid pre-epoch timestamps.
    # The protocol represents an unknown date as zero and otherwise accepts
    # only non-negative integers, so normalize values outside that contract.
    if [[ ! $entry_mtime =~ ^[0-9]+$ ]]; then
      entry_mtime=0
    fi

    valid_utf8=$records_are_utf8
    if [[ $records_are_utf8 == false ]] \
        && printf '%s' "$entry_path" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
      valid_utf8=true
    fi

    if [[ $valid_utf8 == true ]]; then
      entry_name=${entry_path##*/}
      json_batch+=("$entry_path" "$entry_name" "$entry_kind" "$allocated_bytes" "$entry_mtime")
      if (( ${#json_batch[@]} >= metadata_batch_size * 5 )); then
        flush_json_batch
      fi
    else
      flush_json_batch
      emit_invalid_utf8_entry "$entry_path" "$allocated_bytes" "$entry_kind" "$entry_mtime"
    fi
  done
done
flush_json_batch

warning_slots=$max_emitted_warnings
if [[ $truncated == true ]]; then
  (( warning_slots -= 1 ))
fi

while IFS= read -r warning_line || [[ -n $warning_line ]]; do
  [[ -n $warning_line ]] || continue
  (( warning_count += 1 ))
  if (( emitted_warning_count < warning_slots )); then
    jq -cn \
      --argjson protocol "$protocol" \
      --arg message "$warning_line" \
      '{protocol: $protocol, type: "warning", message: $message}'
    (( emitted_warning_count += 1 ))
  fi
done <"$work_dir/errors"

if [[ $truncated == true ]]; then
  (( warning_count += 1 ))
  if (( emitted_warning_count < max_emitted_warnings )); then
    jq -cn \
      --argjson protocol "$protocol" \
      --argjson limit "$max_entries" \
      '{protocol: $protocol, type: "warning", code: "entry-limit", message: ("Only the first " + ($limit|tostring) + " entries are shown.")}'
    (( emitted_warning_count += 1 ))
  fi
fi

partial=false
if (( measure_status != 0 || warning_count > 0 )); then
  partial=true
fi

jq -cn \
  --argjson protocol "$protocol" \
  --arg path "$scan_path" \
  --argjson totalBytes "$total_bytes" \
  --argjson entries "$entry_count" \
  --argjson warnings "$warning_count" \
  --argjson partial "$partial" \
  '{
    protocol: $protocol,
    type: "complete",
    path: $path,
    totalBytes: $totalBytes,
    entries: $entries,
    warnings: $warnings,
    partial: $partial
  }'

exit 0
