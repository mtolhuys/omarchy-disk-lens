#!/bin/bash

# Deterministic stand-in used only to hold the scanner at its cancellation
# boundary. Production scans always resolve the system GNU du.
sleep 30 &
sleep_pid=$!
trap 'kill -TERM "$sleep_pid" 2>/dev/null || true; wait "$sleep_pid" 2>/dev/null || true; exit 143' INT TERM
wait "$sleep_pid"
